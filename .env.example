# SATFIRE v3 configuration template.
# Copy to .env.local (git-ignored) and fill in values. Never commit real keys.
# Environment variables override .env.local.

# ---------------------------------------------------------------- REQUIRED for live data
# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Sources polled (VIIRS primary, MODIS secondary for corroboration)
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# Scope: India bounding box west,south,east,north (configurable scope decision)
FIRMS_BBOX=68,6,98,36
FIRMS_DAY_RANGE=2
# Scheduler: poll inside satellite pass windows (UTC), rarely outside
FIRMS_POLL_WINDOWS_UTC=04:30-12:30,16:30-23:59
FIRMS_POLL_IN_WINDOW_MIN=20
FIRMS_POLL_OUT_WINDOW_MIN=180
# Heartbeat: warn operators if the last successful FIRMS pull is older than this
HEARTBEAT_MAX_AGE_MIN=240
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- dashboard access
# If DASHBOARD_PASSWORD is empty a random one is generated and printed at startup.
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=
# Set for stable sessions across restarts (any long random string)
SESSION_SECRET=
SESSION_TTL_HOURS=12
# true when served over HTTPS
SECURE_COOKIES=false

# ---------------------------------------------------------------- PostGIS (optional; in-memory join + file store otherwise)
# npm run db:up && npm run db:init && npm run db:load
DATABASE_URL=postgres://satfire:satfire_dev@localhost:5433/satfire

# ---------------------------------------------------------------- alert dispatch
# Generic JSON, Discord or Slack incoming-webhook URL. Alerts are stored first, then dispatched.
ALERT_WEBHOOK_URL=
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_MS=2000
# Sample-data alerts are recorded but not sent unless this is true (payload is marked [SAMPLE DATA])
DISPATCH_SAMPLE_ALERTS=false

# ---------------------------------------------------------------- OPTIONAL: LLM phrasing of the SITREP (off by default)
# The LLM only rephrases the template; it never classifies and never gates an alert.
GEMINI_API_KEY=
LLM_PHRASING_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=4000
LLM_MAX_CALLS_PER_HOUR=30
LLM_MAX_CALLS_PER_DAY=200
LLM_DAILY_BUDGET_USD=1.00
# Estimated price per million tokens, used for the spend ceiling
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=2.50

# ---------------------------------------------------------------- basemap (frontend, build-time)
# Leave empty for the public OpenStreetMap tiles (demo use only); set a provider URL for production.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

PORT=8787

# ---------------------------------------------------------------- ROADMAP services (not used by the code yet — see to_do.md)
# Copernicus Data Space Ecosystem (Sentinel-1 SAR / Sentinel-2): free account
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=
# MOSDAC (ISRO) INSAT geostationary thermal: registration + approval needed, apply early
# MOSDAC_USERNAME=
# MOSDAC_PASSWORD=
# Wind: Open-Meteo needs no key (non-commercial); ERA5 via Copernicus Climate Data Store needs a free account
# CDS_API_KEY=
# SMS gateway (Twilio or an Indian provider)
# SMS_PROVIDER=
# SMS_API_KEY=
